# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SELF_ORDER_DEVICE_PEPPER=replace-with-at-least-32-random-characters
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_DB_PASSWORD=your-database-password

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://YOUR_REDIS.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Public HTTPS origin used by Web Push notification links.
NEXT_PUBLIC_APP_URL=https://your-domain.example

# SePay bank webhook for VietQR settlement.
# Configure SePay webhook URL: ${NEXT_PUBLIC_APP_URL}/api/webhooks/sepay
# Authentication method: HMAC-SHA256.
SEPAY_WEBHOOK_SECRET=

# Food delivery POS relay webhook secrets (GrabFood & ShopeeFood Chrome extensions)
GRAB_RELAY_SECRET=
SHOPEE_RELAY_SECRET=

# Cron auth — Bearer token checked by /api/cron/* routes (timing-safe compare).
CRON_SECRET=

# Optional POS/KDS cloud voice (Vercel AI Gateway openai/tts-1 nova). Missing → beep only.
AI_GATEWAY_API_KEY=

# HĐĐT / S-invoice
SINVOICE_USERNAME=
SINVOICE_PASSWORD=
SINVOICE_BASE_URL=
SINVOICE_SANDBOX=true
