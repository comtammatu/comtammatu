# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://YOUR_REDIS.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Vercel
VERCEL_URL=localhost:3000

# Feedback module — Slice 1
TELEGRAM_BOT_TOKEN=
CRON_SECRET=
# Comma-separated list of allowed Origin headers for /r/[token] submit
ALLOWED_ORIGINS_FEEDBACK=http://localhost:3000
# 32+ char random — rotate quarterly. Used to hash submitter IP for spam detection.
IP_HASH_SALT=replace-with-strong-random-32-plus-chars
# Used by server actions for fire-and-forget cron triggers + admin deep links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feedback module — Slice 2 (AI enrichment + daily reports)
ANTHROPIC_API_KEY=
# Override default model (claude-sonnet-4-6). Optional.
FEEDBACK_AI_MODEL=
