# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SELF_ORDER_DEVICE_PEPPER=replace-with-at-least-32-random-characters
SUPABASE_PROJECT_ID=your-project-id

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://YOUR_REDIS.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Public HTTPS origin
# Used by MoMo ipnUrl + Web Push notification links.
# Must be reachable from MoMo servers in prod; localhost OK for dev.
NEXT_PUBLIC_APP_URL=https://your-domain.example

# SePay bank webhook for VietQR settlement.
# Configure SePay webhook URL: ${NEXT_PUBLIC_APP_URL}/api/webhooks/sepay
# Authentication method: HMAC-SHA256.
SEPAY_WEBHOOK_SECRET=

# MoMo QR Payment
# Required to enable MoMo provider registration.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# true = test-payment.momo.vn, false/unset = payment.momo.vn
MOMO_SANDBOX=true
# Optional customer return page after MoMo app finishes. Do not point this to POS.
# Defaults to ${NEXT_PUBLIC_APP_URL}/payment/momo/return.
MOMO_REDIRECT_URL=

# Cron auth — Bearer token checked by /api/cron/* routes (timing-safe compare).
CRON_SECRET=
HDDT_ARCHIVE_ENABLED=false
HDDT_DAILY_SUMMARY_ENABLED=false
HDDT_RECONCILE_ENABLED=false

# HĐĐT / S-invoice
COMPANY_TAX_CODE=
SINVOICE_USERNAME=
SINVOICE_PASSWORD=
SINVOICE_TEMPLATE_CODE=
SINVOICE_INVOICE_SERIES=
SINVOICE_BASE_URL=
SINVOICE_SANDBOX=true
