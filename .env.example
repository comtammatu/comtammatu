# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://YOUR_REDIS.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Vercel
VERCEL_URL=localhost:3000

# Public HTTPS origin used to build MoMo ipnUrl.
# Must be reachable from MoMo servers; localhost will not auto-confirm payments.
NEXT_PUBLIC_APP_URL=https://your-domain.example

# VietQR
VIETQR_API_KEY=
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=

# MoMo QR Payment
# Required to enable MoMo provider registration.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# true = test-payment.momo.vn, false/unset = payment.momo.vn
MOMO_SANDBOX=true
# Optional customer return page after MoMo app finishes. Do not point this to POS.
# Defaults to ${NEXT_PUBLIC_APP_URL}/payment/momo/return.
MOMO_REDIRECT_URL=
