# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://YOUR_REDIS.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# SePay bank webhook for VietQR settlement.
# Configure SePay webhook URL: https://your-domain.example/api/webhooks/sepay
# Authentication method: HMAC-SHA256.
SEPAY_WEBHOOK_SECRET=

# MoMo wallet checkout. `MOMO_BASE_URL` may be omitted only for local sandbox
# development (defaults to https://test-payment.momo.vn); set the live endpoint
# explicitly in every deployed environment.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_BASE_URL=https://test-payment.momo.vn

# Cron auth — Bearer token checked by /api/cron/* routes (timing-safe compare).
CRON_SECRET=
HDDT_ARCHIVE_ENABLED=false
HDDT_DAILY_SUMMARY_ENABLED=false
HDDT_RECONCILE_ENABLED=false

# HĐĐT / S-invoice
COMPANY_TAX_CODE=
SINVOICE_USERNAME=
SINVOICE_PASSWORD=
SINVOICE_TEMPLATE_CODE=
SINVOICE_INVOICE_SERIES=
SINVOICE_BASE_URL=
SINVOICE_SANDBOX=true
