# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SELF_ORDER_DEVICE_PEPPER=replace-with-at-least-32-random-characters
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_DB_PASSWORD=your-database-password

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://YOUR_REDIS.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Public HTTPS origin used by Web Push notification links.
NEXT_PUBLIC_APP_URL=https://your-domain.example

# SePay bank webhook for VietQR settlement.
# Configure SePay webhook URL: ${NEXT_PUBLIC_APP_URL}/api/webhooks/sepay
# Authentication method: HMAC-SHA256.
SEPAY_WEBHOOK_SECRET=

# Cron auth — Bearer token checked by /api/cron/* routes (timing-safe compare).
CRON_SECRET=
HDDT_ARCHIVE_ENABLED=false
HDDT_DAILY_SUMMARY_ENABLED=false
HDDT_RECONCILE_ENABLED=false

# HĐĐT / S-invoice
COMPANY_TAX_CODE=
SINVOICE_USERNAME=
SINVOICE_PASSWORD=
SINVOICE_TEMPLATE_CODE=
SINVOICE_INVOICE_SERIES=
SINVOICE_BASE_URL=
SINVOICE_SANDBOX=true
