# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://YOUR_REDIS.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Vercel
VERCEL_URL=localhost:3000

# Public HTTPS origin
# Used by MoMo ipnUrl + feedback module deep links + cron triggers.
# Must be reachable from MoMo servers in prod; localhost OK for dev.
NEXT_PUBLIC_APP_URL=https://your-domain.example

# Host gate — origin isolation between admin/POS and public feedback form.
# When BOTH set in production, proxy.ts enforces:
#   - feedback host: only /r/* reachable; admin paths return 404
#   - app host: /r/* 308-redirects to feedback host (canonical)
# When unset, both surfaces share one origin (current dev/preview default).
# Production deploy MUST set both — see regressions.md
# FEEDBACK-HOST-SPLIT-COOKIE-DOMAIN-MUST-BE-HOST-ONLY.
NEXT_PUBLIC_APP_HOST=
NEXT_PUBLIC_FEEDBACK_HOST=

# VietQR
VIETQR_API_KEY=
VIETQR_BANK_ID=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=

# MoMo QR Payment
# Required to enable MoMo provider registration.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# true = test-payment.momo.vn, false/unset = payment.momo.vn
MOMO_SANDBOX=true
# Optional customer return page after MoMo app finishes. Do not point this to POS.
# Defaults to ${NEXT_PUBLIC_APP_URL}/payment/momo/return.
MOMO_REDIRECT_URL=

# Feedback module — Slice 1 (QR submit + Telegram alerts)
TELEGRAM_BOT_TOKEN=
CRON_SECRET=
# Comma-separated list of allowed Origin headers for /r/[token] submit.
# In production after host split, list MUST contain the feedback host (e.g.
# https://feedback.comtammatu.com) — NOT the admin host. Submit Server Action
# rejects mismatched Origin headers with 403.
ALLOWED_ORIGINS_FEEDBACK=http://localhost:3000
# 32+ char random — rotate quarterly. Used to hash submitter IP for spam detection.
IP_HASH_SALT=replace-with-strong-random-32-plus-chars

# Feedback module — Slice 2 (AI enrichment + daily reports)
ANTHROPIC_API_KEY=
# Override AI model. Defaults to claude-sonnet-4-6 (cost-effective). Set claude-opus-4-6 for higher accuracy.
FEEDBACK_AI_MODEL=
