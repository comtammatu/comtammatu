{
  "manifest_version": 3,
  "name": "Grab POS Relay — Cơm Tấm Má Tư",
  "version": "1.2.4",
  "description": "Tự động bắt đơn hàng từ GrabMerchant và đẩy thẳng vào KDS Bếp & Máy in Cơm Tấm Má Tư",
  "permissions": [
    "storage",
    "alarms",
    "idle"
  ],
  "host_permissions": [
    "https://merchant.grab.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Grab POS Relay Status"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://merchant.grab.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js"
      ],
      "matches": [
        "https://merchant.grab.com/*"
      ]
    }
  ]
}
