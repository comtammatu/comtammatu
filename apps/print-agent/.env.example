SUPABASE_URL=https://iexwsuaqqenyjiskawoj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
AGENT_TENANT_ID=1
AGENT_BRANCH_ID=1
AGENT_ID=agent-branch-1
AGENT_VERSION=0.4.0
# PRINT_MODE=text         # 'text' (default) | 'bitmap' — use 'bitmap' for PDIT PD805KL / clones
#                         #   without CP1258 firmware font. Renders Vietnamese as rasterized
#                         #   images via Roboto Mono TTF. Codepage-agnostic.
# PRINT_CODEPAGE_ID=38    # Text-mode only. ESC/POS register for CP1258. Default 38 (Epson).
# PRINT_ASCII=0           # Text-mode fallback. Set to '1' to strip diacritics.

# ─── Bluetooth printers ─────────────────────────────────────────────────
# For printers with connection_type='bluetooth', the OS must pair/bind the
# printer first, then the agent writes raw ESC/POS bytes to that endpoint.
# Store the endpoint in printers.lan_host via the settings screen, or override
# locally per printer/role:
# PRINT_BT_TARGETS={"12":"COM5","kitchen_1":"/dev/rfcomm0"}
# PRINT_BT_TARGET_RECEIPT=COM5

# ─── Network gate ──────────────────────────────────────────────────────
# Optional. If set, agent registers branch's NAT egress IP every 5 min via
# the web app's /api/branch-presence endpoint, allowing proxy.ts to permit
# POS/KDS access only from devices on the same wifi.
# Leave both unset to disable presence registration (web app must also
# disable POS_NETWORK_GATE — otherwise no device will pass the gate).
# WEB_BASE_URL=https://app.comtammatu.com
# PRINT_AGENT_PRESENCE_TOKEN=<shared bearer token, identical on web app>
