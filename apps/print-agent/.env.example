# Print-agent branch env catalog (canonical for SETUP.cmd / branch.env).
# Copy to `.env` on the POS PC, or send as `branch.env` from HQ:
#   SETUP.cmd -EnvFile branch.env
#
# Never commit real secrets. Do not sync `.env` to cloud drives.
# Restrict NTFS ACL to the service account + Administrators.

# ─── Required ──────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-jwt>
AGENT_TENANT_ID=<numeric-tenant-id>
AGENT_BRANCH_ID=<numeric-branch-id>

# Stable per-agent id. Bound to PRINT_AGENT_PRESENCE_TOKEN — do not rename
# after provision. Convention: branch slug (e.g. nguyen-huu-tho).
AGENT_ID=<branch-slug>

# ─── Web base URL + presence (production branches) ─────────────────────
# WEB_BASE_URL is used for:
#   1) customer invoice QR on receipts (absolute URL)
#   2) branch-presence registration when POS_NETWORK_GATE is on
# If WEB_BASE_URL is set, PRINT_AGENT_PRESENCE_TOKEN is required.
# If PRINT_AGENT_PRESENCE_TOKEN is set, AGENT_ID is required.
# Leave both blank only for local print-only smoke without presence/QR host.
WEB_BASE_URL=https://<app-host>
PRINT_AGENT_PRESENCE_TOKEN=<raw-token-from-presence-provision>
# Provision / rotate / revoke from the repo (not on the branch PC):
#   corepack pnpm --filter @comtammatu/print-agent presence:provision -- create \
#     --tenant-id <id> --branch-id <id> --agent-id <branch-slug> \
#     --confirm-project-ref <project-ref>
# DB stores only the SHA-256 hash; the CLI prints the raw token once.

# ─── Print retry (optional — defaults are fine for most kitchens) ──────
# A failed dispatch is terminal (status='failed'); the agent resends a few
# times with backoff first so a brief LAN blip does not drop the ticket.
# PRINT_TIMEOUT_MS=5000
# PRINT_MAX_ATTEMPTS=3
# PRINT_RETRY_BACKOFF_MS=750
