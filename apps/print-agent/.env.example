SUPABASE_URL=https://iexwsuaqqenyjiskawoj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
AGENT_TENANT_ID=1
AGENT_BRANCH_ID=1
AGENT_ID=agent-branch-1
AGENT_VERSION=0.3.0
# PRINT_MODE=text         # 'text' (default) | 'bitmap' — use 'bitmap' for PDIT PD805KL / clones
#                         #   without CP1258 firmware font. Renders Vietnamese as rasterized
#                         #   images via Roboto Mono TTF. Codepage-agnostic.
# PRINT_CODEPAGE_ID=38    # Text-mode only. ESC/POS register for CP1258. Default 38 (Epson).
# PRINT_ASCII=0           # Text-mode fallback. Set to '1' to strip diacritics.

# ─── Network gate ──────────────────────────────────────────────────────
# Optional. If set, agent registers the branch NAT egress IP every 5 min via
# the web app's /api/branch-presence endpoint, allowing proxy.ts to permit
# POS/KDS access only from devices on the same wifi.
# Leave both unset to disable presence registration. When POS_NETWORK_GATE is
# enabled in the web app, provision this per-agent token through:
#   pnpm --filter @comtammatu/print-agent presence:provision -- create ...
# WEB_BASE_URL=https://app.comtammatu.com
# PRINT_AGENT_PRESENCE_TOKEN=<raw per-agent token returned by the CLI>
