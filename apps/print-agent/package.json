{
  "name": "@comtammatu/print-agent",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "comtammatu-print-agent": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:codepage": "tsx scripts/test-codepage.ts",
    "test:bitmap": "tsx scripts/test-bitmap.ts",
    "test:vn27": "tsx scripts/test-vn27.ts",
    "test:all": "tsx scripts/test-all.ts",
    "test:document": "tsx scripts/test-document-render.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "dotenv": "^17.2.0",
    "iconv-lite": "^0.6.3",
    "pureimage": "^0.4.18"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
