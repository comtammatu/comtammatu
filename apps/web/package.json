{
  "name": "@comtammatu/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "dev:clean": "rm -rf .next && next dev",
    "bones:build": "boneyard-js build",
    "build": "next build && serwist build",
    "build:turbo": "next build && serwist build",
    "build:webpack": "next build --webpack && serwist build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "realtime:load": "dotenv -e ../../.env.local -e .env.local -e .env.test.local -- tsx scripts/realtime-load-harness.ts",
    "test:e2e": "dotenv -e .env.test.local -- playwright test",
    "test:e2e:ui": "dotenv -e .env.test.local -- playwright test --ui",
    "guides:capture": "dotenv -e .env.test.local -- playwright test --project=guides",
    "guides:capture:list": "dotenv -e .env.test.local -- playwright test --project=guides --list",
    "ui:add": "shadcn add",
    "ui:add-missing": "shadcn add"
  },
  "dependencies": {
    "@comtammatu/database": "workspace:*",
    "@comtammatu/shared": "workspace:*",
    "@comtammatu/ui": "workspace:*",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-table": "^8.21.3",
    "boneyard-js": "^1.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.6",
    "@playwright/test": "^1.60.0",
    "@serwist/cli": "^9.5.11",
    "@serwist/next": "^9.5.11",
    "@supabase/supabase-js": "^2.106.1",
    "@tailwindcss/postcss": "~4.2.4",
    "@types/node": "^24.12.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "serwist": "^9.5.11",
    "shadcn": "^4.8.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
