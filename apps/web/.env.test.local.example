# E2E test environment — copy to .env.test.local and fill in values
# These are NEVER committed. Add .env.test.local to .gitignore if not already there.

# Supabase connection (same as .env.local — can reuse prod instance with test data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Test user credentials — cashier is required; branch/tenant are auto-derived from profile
E2E_CASHIER_EMAIL=e2e-cashier@comtammatu.com
E2E_CASHIER_PASSWORD=your-test-password

# Optional chef credentials for KDS smoke tests.
# If omitted, the E2E helper will try to discover a chef in the cashier's branch
# and reuse the cashier password as a fallback.
E2E_CHEF_EMAIL=e2e-chef@comtammatu.com
E2E_CHEF_PASSWORD=your-test-password

# Optional overrides for pre-existing fixtures.
# If omitted or invalid, the E2E helper will create missing menu/category/session/table fixtures.
E2E_TEST_TENANT_ID=1
E2E_TEST_BRANCH_ID=1
E2E_TEST_MENU_ITEM_ID=1

# Base URL for the running Next.js app
E2E_BASE_URL=http://localhost:3000
