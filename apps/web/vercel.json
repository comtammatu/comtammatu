{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "phuoc-hai": true
    }
  },
  "regions": ["sin1"],
  "crons": [
    {
      "path": "/api/cron/kds-maintenance",
      "schedule": "0 5,11,17,23 * * *"
    },
    {
      "path": "/api/cron/tax-invoice-issue",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/momo-reconcile",
      "schedule": "* * * * *"
    }
  ]
}
