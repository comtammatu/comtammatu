{
  "name": "comtammatu",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "pnpm lint:copy && pnpm lint:v2-imports && turbo lint",
    "lint:copy": "node scripts/lint-copy.mjs",
    "lint:v2-imports": "node scripts/check-v2-imports.mjs",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > packages/database/src/types/database.types.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "turbo": "^2.9.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.0"
  },
  "pnpm": {
    "overrides": {
      "zod": "4.3.6"
    }
  }
}