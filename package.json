{
  "name": "comtammatu",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/run-turbo.mjs run dev",
    "dev:web": "node scripts/run-turbo.mjs run dev --filter=@comtammatu/web",
    "dev:print": "node scripts/run-turbo.mjs run dev --filter=@comtammatu/print-agent",
    "build": "node scripts/run-turbo.mjs run build",
    "lint": "corepack pnpm lint:copy && corepack pnpm lint:language-policy && corepack pnpm lint:ui-contract && corepack pnpm audit:ui-components && corepack pnpm lint:client-storage && corepack pnpm lint:runtime-identities && corepack pnpm lint:docs-budget && corepack pnpm lint:agent-start && corepack pnpm lint:git-hooks && corepack pnpm lint:migration-lineage && corepack pnpm lint:typegen && corepack pnpm lint:guard-sync && corepack pnpm lint:preview-env && corepack pnpm lint:seed-permissions && corepack pnpm lint:regression-guards && corepack pnpm lint:doc-staleness && corepack pnpm lint:retired-legal-literals && corepack pnpm lint:i18n:no-grow && corepack pnpm lint:route-matrix && node scripts/run-turbo.mjs run lint",
    "agent:start": "node scripts/agent-start.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "git:hooks:install": "node scripts/install-git-hooks.mjs",
    "lint:agent-start": "node --test scripts/agent-start.test.mjs",
    "lint:git-hooks": "node --test scripts/git-hooks.test.mjs && node scripts/check-git-hooks.mjs",
    "lint:docs-budget": "node scripts/check-docs-budget.mjs --self-test && node scripts/check-docs-budget.mjs",
    "lint:language-policy": "node scripts/check-language-policy.mjs --self-test && node scripts/check-language-policy.mjs",
    "lint:client-storage": "node scripts/check-client-storage.mjs",
    "lint:runtime-identities": "node --test scripts/check-runtime-identities.test.mjs && node scripts/check-runtime-identities.mjs",
    "lint:copy": "node scripts/lint-copy.mjs",
    "lint:doc-staleness": "node scripts/check-doc-staleness.mjs --self-test && node scripts/check-doc-staleness.mjs",
    "lint:guard-sync": "node scripts/check-guard-sync.mjs",
    "lint:i18n": "I18N_BASELINE_DISABLE=1 corepack pnpm --filter @comtammatu/web exec eslint .",
    "lint:i18n:baseline": "node scripts/update-i18n-baseline.mjs",
    "lint:i18n:no-grow": "node scripts/check-i18n-baseline-monotonic.mjs",
    "lint:migration-lineage": "node --test scripts/supabase-migration-new.test.mjs && node scripts/check-migration-lineage.mjs",
    "lint:preview-env": "node scripts/check-preview-supabase-env.mjs --self-test && node scripts/check-preview-supabase-env.mjs",
    "lint:retired-legal-literals": "node scripts/check-retired-legal-literals.mjs",
    "lint:regression-guards": "node scripts/check-regression-guards.mjs",
    "lint:route-matrix": "node scripts/gen-role-route-matrix.mjs --check",
    "lint:seed-permissions": "node scripts/check-seed-permission-sync.mjs",
    "lint:typegen": "node --test scripts/gen-types.test.mjs",
    "lint:ui-contract": "node scripts/check-ui-contract.mjs --self-test && node scripts/check-ui-contract.mjs",
    "gen:route-matrix": "node scripts/gen-role-route-matrix.mjs",
    "audit:ui-components": "node scripts/audit-ui-components.mjs",
    "regressions:retire-candidates": "node scripts/list-regression-retire-candidates.mjs",
    "deps:audit": "node scripts/deps-audit.mjs",
    "deps:security": "corepack pnpm audit --audit-level=high",
    "deps:boundaries": "node scripts/run-turbo.mjs boundaries",
    "typecheck": "node scripts/run-turbo.mjs run typecheck",
    "test": "node scripts/run-turbo.mjs run test && corepack pnpm test:operational-tools",
    "test:operational-tools": "node scripts/check-operational-tools.mjs",
    "verify": "corepack pnpm deps:security && corepack pnpm deps:audit && corepack pnpm deps:boundaries && corepack pnpm typecheck && corepack pnpm lint && corepack pnpm build && corepack pnpm test",
    "realtime:load": "corepack pnpm --filter @comtammatu/web realtime:load",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:types": "node scripts/gen-types.mjs",
    "db:baseline:extract": "node scripts/supabase-baseline-extract.mjs",
    "db:baseline:extract:dry-run": "node scripts/supabase-baseline-extract.mjs --dry-run",
    "db:baseline:local-check": "node scripts/supabase-baseline-local-check.mjs",
    "db:test": "node scripts/run-db-tests.mjs",
    "db:schema-drift": "node scripts/check-schema-drift.mjs",
    "hddt:export": "corepack pnpm --filter @comtammatu/web hddt:export",
    "inventory:csv-reseed:dry-run": "corepack pnpm --filter @comtammatu/web inventory:csv-reseed:dry-run",
    "clean:web": "node scripts/clean-web.mjs",
    "docs:okf": "node scripts/export-okf.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.5",
    "supabase": "2.109.1",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<=5.0.7": ">=5.0.9",
      "exceljs>unzipper": "0.12.5",
      "exceljs>uuid": "11.1.1",
      "nanoid@<3.3.18": "3.3.18",
      "next>postcss": "8.5.19",
      "next>sharp": "0.35.3"
    }
  }
}
