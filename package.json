{
  "name": "comtammatu",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@comtammatu/web",
    "dev:print": "turbo dev --filter=@comtammatu/print-agent",
    "build": "turbo build",
    "lint": "pnpm lint:copy && pnpm lint:v2-imports && turbo lint",
    "lint:rebuild-strict": "pnpm lint:no-version-suffixes && pnpm lint:doc-xref",
    "lint:copy": "node scripts/lint-copy.mjs",
    "lint:i18n": "I18N_BASELINE_DISABLE=1 pnpm --filter @comtammatu/web exec eslint .",
    "lint:i18n:baseline": "node scripts/update-i18n-baseline.mjs",
    "lint:v2-imports": "node scripts/check-v2-imports.mjs",
    "lint:no-version-suffixes": "node scripts/check-no-version-suffixes.mjs",
    "lint:doc-xref": "node scripts/check-doc-cross-references.mjs",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "verify": "pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "bones:build": "pnpm --filter @comtammatu/web bones:build",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:types": "node scripts/gen-types.mjs",
    "clean:web": "node scripts/clean-web.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "turbo": "^2.9.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.0"
  },
  "pnpm": {
    "overrides": {
      "zod": "4.3.6"
    }
  }
}
