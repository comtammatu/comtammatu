{
  "name": "comtammatu",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@comtammatu/web",
    "dev:print": "turbo dev --filter=@comtammatu/print-agent",
    "build": "turbo build",
    "lint": "pnpm lint:copy && pnpm lint:ui-contract && pnpm lint:client-storage && pnpm lint:rules-mirror && pnpm lint:guard-sync && pnpm lint:regression-guards && pnpm lint:review-tier && pnpm lint:doc-staleness && turbo lint",
    "lint:baseline": "node scripts/check-baseline-hygiene.mjs",
    "lint:client-storage": "node scripts/check-client-storage.mjs",
    "lint:copy": "node scripts/lint-copy.mjs",
    "lint:doc-staleness": "node scripts/check-doc-staleness.mjs",
    "lint:guard-sync": "node scripts/check-guard-sync.mjs",
    "lint:i18n": "I18N_BASELINE_DISABLE=1 pnpm --filter @comtammatu/web exec eslint .",
    "lint:i18n:baseline": "node scripts/update-i18n-baseline.mjs",
    "lint:regression-guards": "node scripts/check-regression-guards.mjs",
    "lint:review-tier": "node scripts/check-review-tier.mjs",
    "lint:rules-mirror": "node scripts/check-rules-mirror.mjs",
    "lint:ui-contract": "node scripts/check-ui-contract.mjs",
    "audit:ui-components": "node scripts/audit-ui-components.mjs",
    "regressions:retire-candidates": "node scripts/list-regression-retire-candidates.mjs",
    "deps:audit": "node scripts/deps-audit.mjs",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "verify": "pnpm deps:audit && pnpm lint:baseline && pnpm typecheck && pnpm lint && pnpm build && pnpm test",
    "realtime:load": "pnpm --filter @comtammatu/web realtime:load",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:types": "node scripts/gen-types.mjs",
    "db:baseline:extract": "node scripts/supabase-baseline-extract.mjs",
    "db:baseline:extract:dry-run": "node scripts/supabase-baseline-extract.mjs --dry-run",
    "db:baseline:local-check": "node scripts/supabase-baseline-local-check.mjs",
    "inventory:matu-platform:dry-run": "node --env-file=.env.local scripts/inventory-matu-platform-dry-run.mjs",
    "inventory:matu-platform:master-data": "node --env-file=.env.local scripts/inventory-matu-platform-master-data.mjs",
    "inventory:matu-platform:operational": "node --env-file=.env.local scripts/inventory-matu-platform-operational-import.mjs",
    "clean:web": "node scripts/clean-web.mjs",
    "docs:okf": "node scripts/export-okf.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  }
}
