{
  "name": "comtammatu",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "PATH=$(dirname $(command -v corepack)):$PATH turbo dev",
    "dev:web": "PATH=$(dirname $(command -v corepack)):$PATH turbo dev --filter=@comtammatu/web",
    "dev:print": "PATH=$(dirname $(command -v corepack)):$PATH turbo dev --filter=@comtammatu/print-agent",
    "build": "PATH=$(dirname $(command -v corepack)):$PATH turbo build",
    "lint": "corepack pnpm lint:copy && corepack pnpm lint:ui-contract && corepack pnpm lint:client-storage && corepack pnpm lint:rules-mirror && corepack pnpm lint:migration-lineage && corepack pnpm lint:guard-sync && corepack pnpm lint:seed-permissions && corepack pnpm lint:regression-guards && corepack pnpm lint:baseline && corepack pnpm lint:review-tier && corepack pnpm lint:doc-staleness && corepack pnpm lint:i18n:no-grow && corepack pnpm lint:route-matrix && PATH=$(dirname $(command -v corepack)):$PATH turbo lint",
    "lint:baseline": "node scripts/check-baseline-hygiene.mjs",
    "lint:client-storage": "node scripts/check-client-storage.mjs",
    "lint:copy": "node scripts/lint-copy.mjs",
    "lint:doc-staleness": "node scripts/check-doc-staleness.mjs",
    "lint:guard-sync": "node scripts/check-guard-sync.mjs",
    "lint:i18n": "I18N_BASELINE_DISABLE=1 corepack pnpm --filter @comtammatu/web exec eslint .",
    "lint:i18n:baseline": "node scripts/update-i18n-baseline.mjs",
    "lint:i18n:no-grow": "node scripts/check-i18n-baseline-monotonic.mjs",
    "lint:migration-lineage": "node scripts/check-migration-lineage.mjs",
    "lint:regression-guards": "node scripts/check-regression-guards.mjs",
    "lint:review-tier": "node scripts/check-review-tier.mjs",
    "lint:route-matrix": "node scripts/gen-role-route-matrix.mjs --check",
    "lint:rules-mirror": "node scripts/check-rules-mirror.mjs",
    "lint:seed-permissions": "node scripts/check-seed-permission-sync.mjs",
    "lint:ui-contract": "node scripts/check-ui-contract.mjs",
    "gen:route-matrix": "node scripts/gen-role-route-matrix.mjs",
    "audit:ui-components": "node scripts/audit-ui-components.mjs",
    "regressions:retire-candidates": "node scripts/list-regression-retire-candidates.mjs",
    "deps:audit": "node scripts/deps-audit.mjs",
    "typecheck": "PATH=$(dirname $(command -v corepack)):$PATH turbo typecheck",
    "test": "PATH=$(dirname $(command -v corepack)):$PATH turbo test",
    "verify": "corepack pnpm deps:audit && corepack pnpm lint:baseline && corepack pnpm typecheck && corepack pnpm lint && corepack pnpm build && corepack pnpm test",
    "realtime:load": "corepack pnpm --filter @comtammatu/web realtime:load",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:types": "node scripts/gen-types.mjs",
    "db:baseline:extract": "node scripts/supabase-baseline-extract.mjs",
    "db:baseline:extract:dry-run": "node scripts/supabase-baseline-extract.mjs --dry-run",
    "db:baseline:local-check": "node scripts/supabase-baseline-local-check.mjs",
    "db:test": "node scripts/run-db-tests.mjs",
    "db:schema-drift": "node scripts/check-schema-drift.mjs",
    "test:db:payment-race": "node scripts/run-payment-provider-race.mjs",
    "hddt:export": "corepack pnpm --filter @comtammatu/web hddt:export",
    "inventory:cleanup:dry-run": "corepack pnpm --filter @comtammatu/web inventory:cleanup:dry-run",
    "inventory:csv-reseed:dry-run": "corepack pnpm --filter @comtammatu/web inventory:csv-reseed:dry-run",
    "clean:web": "node scripts/clean-web.mjs",
    "docs:okf": "node scripts/export-okf.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4"
  }
}
