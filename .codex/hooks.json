{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/guard-prod-db.mjs\""
          }
        ]
      },
      {
        "matcher": "^mcp__(?:supabase|.+?(?:__|[._]+)supabase)(?:__|[._]+)([A-Za-z0-9_-]+)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/guard-prod-db.mjs\""
          }
        ]
      }
    ]
  }
}
