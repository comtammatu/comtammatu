{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**",
        "public/sw.js",
        "public/sw.js.map",
        "public/swe-worker-*.js",
        "public/workbox-*.js"
      ]
    },
    "@comtammatu/web#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.env.local", ".env.local"],
      "env": [
        "CI",
        "NEXT_PUBLIC_SUPABASE_URL",
        "SUPABASE_PROJECT_ID",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_APP_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "POS_NETWORK_GATE",
        "COMPANY_TAX_CODE",
        "SINVOICE_USERNAME",
        "SINVOICE_PASSWORD",
        "SINVOICE_TEMPLATE_CODE",
        "SINVOICE_INVOICE_SERIES",
        "SINVOICE_BASE_URL",
        "SINVOICE_SANDBOX",
        "VIETQR_API_KEY",
        "VIETQR_BANK_ID",
        "VIETQR_ACCOUNT_NO",
        "VIETQR_ACCOUNT_NAME",
        "CRON_SECRET",
        "SEPAY_WEBHOOK_SECRET",
        "DISABLE_LOGIN_RATE_LIMIT",
        "ENABLE_DEBUG_CLAIMS",
        "VERCEL_ENV"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**",
        "public/sw.js",
        "public/sw.js.map",
        "public/swe-worker-*.js",
        "public/workbox-*.js"
      ]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.mjs"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@comtammatu/shared#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/supabase/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/apps/web/**",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/tasks/**"
      ],
      "outputs": []
    },
    "@comtammatu/web#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/supabase/migrations/**",
        "$TURBO_ROOT$/scripts/**"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
