{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**",
        "public/sw.js",
        "public/sw.js.map",
        "public/swe-worker-*.js",
        "public/workbox-*.js"
      ]
    },
    "@comtammatu/web#build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_APP_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "POS_NETWORK_GATE",
        "COMPANY_TAX_CODE",
        "!INVOICE_PROVIDER",
        "SINVOICE_USERNAME",
        "SINVOICE_PASSWORD",
        "SINVOICE_TEMPLATE_CODE",
        "SINVOICE_INVOICE_SERIES",
        "MOMO_PARTNER_CODE",
        "MOMO_ACCESS_KEY",
        "MOMO_SECRET_KEY",
        "HDDT_RECONCILE_ENABLED"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**",
        "public/sw.js",
        "public/sw.js.map",
        "public/swe-worker-*.js",
        "public/workbox-*.js"
      ]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
