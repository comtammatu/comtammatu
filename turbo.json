{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@comtammatu/web#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/scripts/check-preview-supabase-env.mjs",
        "$TURBO_ROOT$/.env.local",
        ".env.local"
      ],
      "env": [
        "CI",
        "NEXT_PUBLIC_SUPABASE_URL",
        "SUPABASE_PROJECT_ID",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_APP_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "POS_NETWORK_GATE",
        "SINVOICE_USERNAME",
        "SINVOICE_PASSWORD",
        "SINVOICE_BASE_URL",
        "SINVOICE_SANDBOX",
        "VIETQR_API_KEY",
        "VIETQR_BANK_ID",
        "VIETQR_ACCOUNT_NO",
        "VIETQR_ACCOUNT_NAME",
        "CRON_SECRET",
        "SEPAY_WEBHOOK_SECRET",
        "DISABLE_LOGIN_RATE_LIMIT",
        "ENABLE_DEBUG_CLAIMS",
        "VERCEL_PROJECT_ID",
        "VERCEL_ENV"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**",
        "public/sw.js",
        "public/sw.js.map",
        "public/swe-worker-*.js",
        "public/workbox-*.js"
      ]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.mjs"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "outputs": ["*.tsbuildinfo"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.base.json"],
      "outputs": []
    },
    "@comtammatu/shared#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/web/app/**",
        "$TURBO_ROOT$/apps/web/lib/**",
        "$TURBO_ROOT$/apps/web/proxy.ts",
        "$TURBO_ROOT$/apps/web/vercel.json",
        "$TURBO_ROOT$/apps/web/tests/fixtures/supabase-e2e/**",
        "$TURBO_ROOT$/packages/database/src/types/database.types.ts",
        "$TURBO_ROOT$/supabase/migrations/**",
        "$TURBO_ROOT$/supabase/migration-archive/**",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/tasks/todo.md"
      ],
      "outputs": []
    },
    "@comtammatu/web#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "$TURBO_ROOT$/supabase/migrations/**",
        "$TURBO_ROOT$/supabase/migration-archive/**",
        "$TURBO_ROOT$/supabase/tests/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/docs/**"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
