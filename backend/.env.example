# Copy to .env and fill in values. Never commit .env to git.

# PostgreSQL connection string — use the "direct connection" URL from Supabase project settings.
# Format: postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgres://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# JWT secret — Settings > API > JWT Settings > JWT Secret in Supabase dashboard.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Comma-separated list of allowed CORS origins. Use * for local development only.
ALLOWED_ORIGINS=http://localhost:3000

# Port to listen on (default: 8080)
PORT=8080
