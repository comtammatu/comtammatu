# Copy to .env and fill in values. Never commit .env to git.

# JWT secret — Settings > API > JWT Settings > JWT Secret in Supabase dashboard.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Comma-separated list of allowed CORS origins. Do not use * with credentialed requests.
ALLOWED_ORIGINS=http://localhost:3000

# Runtime environment: development, test, or production.
APP_ENV=development

# Port to listen on (default: 8080)
PORT=8080
